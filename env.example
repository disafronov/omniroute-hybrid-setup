# Local password
INITIAL_PASSWORD=your-initial-password
# Local API key — used by both docker compose (mapped to OMNIROUTE_API_KEY) and main.py
OMNIROUTE_LOCAL_API_KEY=sk-your-local-key-here
# Local OmniRoute base URL (optional, default: http://127.0.0.1:20128)
OMNIROUTE_LOCAL_BASE_URL=http://127.0.0.1:20128

# Upstream cloud OmniRoute API key
OMNIROUTE_CLOUD_API_KEY=sk-your-cloud-key-here
# Upstream cloud OmniRoute base URL
OMNIROUTE_CLOUD_BASE_URL=https://omniroute.hostname.tld

# Runtime endpoint (optional, default: http://host.docker.internal:11434/v1)
# OMNIROUTE_LOCAL_RUNTIME_URL=http://host.docker.internal:11434/v1
# Local runtime models for each combo (optional, defaults below)
OMNIROUTE_LOCAL_RUNTIME_MODEL_FAST=qwen3.5:2b-q4_K_M
OMNIROUTE_LOCAL_RUNTIME_MODEL_CODING=qwen3.5:4b-q4_K_M
OMNIROUTE_LOCAL_RUNTIME_MODEL_CODING_FAST=qwen3.5:4b-q4_K_M
OMNIROUTE_LOCAL_RUNTIME_MODEL_REASONING=qwen3.5:9b-q4_K_M
OMNIROUTE_LOCAL_RUNTIME_MODEL_VISION=qwen3-vl:4b
