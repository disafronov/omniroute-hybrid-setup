# Feature flags
REQUIRE_API_KEY=true

# Long-running local inference can spend many minutes in prefill or thinking
# before emitting an SSE chunk. Keep the bridge alive for 25 minutes.
REQUEST_TIMEOUT_MS=1500000
FETCH_TIMEOUT_MS=1500000
FETCH_HEADERS_TIMEOUT_MS=1500000
FETCH_BODY_TIMEOUT_MS=1500000
STREAM_READINESS_TIMEOUT_MS=1500000
STREAM_IDLE_TIMEOUT_MS=1500000
API_BRIDGE_PROXY_TIMEOUT_MS=1500000
API_BRIDGE_SERVER_REQUEST_TIMEOUT_MS=1500000
TLS_CLIENT_TIMEOUT_MS=1500000
