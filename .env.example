# Upstream cloud OmniRoute API key
OMNIROUTE_CLOUD_API_KEY=sk-your-cloud-key-here
# Upstream cloud OmniRoute base URL
OMNIROUTE_CLOUD_BASE_URL=https://omniroute.hostname.tld

# Local API key — used by both docker compose (mapped to OMNIROUTE_API_KEY) and main.py
OMNIROUTE_LOCAL_API_KEY=sk-your-local-key-here
# Local OmniRoute base URL (optional, default: http://127.0.0.1:20128)
OMNIROUTE_LOCAL_BASE_URL=http://127.0.0.1:20128

# Ollama endpoint (optional, default: http://host.docker.internal:11434/v1)
OMNIROUTE_LOCAL_OLLAMA_URL=http://host.docker.internal:11434/v1
# Local ollama models for each combo (optional, defaults below)
OMNIROUTE_LOCAL_OLLAMA_MODEL_FAST=qwen3.5:2b-q4_K_M
OMNIROUTE_LOCAL_OLLAMA_MODEL_CODING=qwen3.5:4b-q4_K_M
OMNIROUTE_LOCAL_OLLAMA_MODEL_REASONING=qwen3.5:9b-q4_K_M
OMNIROUTE_LOCAL_OLLAMA_MODEL_VISION=qwen2.5vl:3b
